SUPABASE_URL=
SUPABASE_KEY=

# Optional run-time secret of the server. With it, invites use Supabase's
# invite API and the "Invite user" email. Without it, invites send a
# sign-in link. Set it in the environment of the running server only.
# Never put it in the build environment, and never commit it.
# NUXT_SUPABASE_SECRET_KEY=

# Optional Pluto mail (run-time secrets of the server, never in the build
# environment). With the service role key above AND a working mail driver,
# invites go out through Pluto mail, not through Supabase's mailer. Set these
# in the environment of the running server. See the `mail` skill of
# @plutocms/pluto for every variable.
# NUXT_PLUTO_MAIL_RESEND_API_KEY=
# NUXT_PLUTO_MAIL_FROM="Your Site <hello@your-domain.com>"
